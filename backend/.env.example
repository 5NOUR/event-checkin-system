# ==========================================
# Event Check-in System - Environment Variables
# ==========================================

# ============ Environment ============
NODE_ENV="development"

# ============ Database ============
# للتطوير المحلي (Docker):
# DATABASE_URL="postgresql://eventadmin:securepassword123@localhost:5432/eventdb"

# للإنتاج (Neon - مثال):
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ============ Server ============
PORT=5000

# ============ Authentication ============
# ⚠️ غيّرها في الإنتاج إلى قيمة طويلة وعشوائية (32+ حرف)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"

# ============ Frontend URL (CORS) ============
# للتطوير:
FRONTEND_URL="http://localhost:5173"

# للإنتاج (Vercel - مثال):
# FRONTEND_URL="https://event-checkin.vercel.app"

# ============ Email Service ============
# الخيارات: console (تطوير) | ethereal (تطوير مرئي) | resend (إنتاج)
EMAIL_PROVIDER="console"

# البريد المرسل منه (يجب أن يكون على نطاق موثّق في Resend)
EMAIL_FROM="noreply@eventcheck.app"
EMAIL_FROM_NAME="EventCheck"

# مفتاح Resend (فقط في الإنتاج مع EMAIL_PROVIDER=resend)
RESEND_API_KEY=""
# ============ Database ============
# Pooled connection (للتطبيق)
DATABASE_URL="postgresql://neondb_owner:npg_kWovRr56CKBO@ep-billowing-morning-av6fbs3i-pooler.c-11.us-east-1.aws.neon.tech/eventdb?sslmode=require&channel_binding=require"
# Direct connection (للـ Migrations)
DIRECT_URL="postgresql://neondb_owner:npg_kWovRr56CKBO@ep-billowing-morning-av6fbs3i.c-11.us-east-1.aws.neon.tech/eventdb?sslmode=require&channel_binding=require"