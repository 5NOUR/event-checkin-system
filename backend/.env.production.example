# ==========================================
# Event Check-in System - PRODUCTION
# ==========================================

# ============ Environment ============
NODE_ENV="production"

# ============ Database (Neon) ============
# استبدل بـ connection string من Neon
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# ============ Server ============
PORT=5000

# ============ Authentication ============
# ⚠️ غيّرها إلى قيمة عشوائية طويلة (32+ حرف)
# يمكن توليدها بـ: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"

# ============ Frontend URL (CORS) ============
# استبدل بـ نطاق Vercel الحقيقي
FRONTEND_URL="https://your-app.vercel.app"

# ============ Email Service ============
EMAIL_PROVIDER="resend"
EMAIL_FROM="noreply@yourdomain.com"
EMAIL_FROM_NAME="EventCheck"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxx"