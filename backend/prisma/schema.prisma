// هذا هو ملف تعريف قاعدة البيانات
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- أنواع Enum (القيم المحددة مسبقاً) ----------
enum Role {
  ADMIN
  ORGANIZER
  STAFF
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CheckInMethod {
  QR_SCAN
  MANUAL
}

// ---------- الجداول (Models) ----------

// المستخدمون (المشرفون، المنظمون، الموظفون)
model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // العلاقات
  events       Event[]       @relation("OrganizerEvents")
  staffAssign  EventStaff[]  @relation("StaffAssignments")
  checkIns     CheckIn[]     @relation("CheckInByUser")
  notifications Notification[]
  auditLogs    AuditLog[]
  refreshTokens RefreshToken[]
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  assignedGates EventStaffGate[]
}

// الفعاليات
model Event {
  id          String      @id @default(uuid())
  title       String
  slug        String      @unique
  description String      @db.Text
  coverImageUrl String?
  location    String
  date        DateTime
  startTime   String      // مثلاً "09:00"
  endTime     String      // مثلاً "17:00"
  capacity    Int
  registrationDeadline DateTime?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // المفتاح الخارجي للمنظم
  organizerId String
  organizer   User        @relation("OrganizerEvents", fields: [organizerId], references: [id])

  // العلاقات الأخرى
  registrations Registration[]
  staff         EventStaff[]
  waitlist     Waitlist[]
  speakers    Speaker[]    // ✅ إضافة العلاقة مع المتحدثين
  agendaItems AgendaItem[] // ✅ إضافة العلاقة مع الأجندة
  faqs          Faq[]
  sponsors      Sponsor[]
  galleryImages GalleryImage[]
  gates Gate[]
  ticketTypes TicketType[]

}

// ربط الموظفين بالفعاليات (علاقة كثير إلى كثير)
model EventStaff {
  id         String   @id @default(uuid())
  eventId    String
  staffId    String
  isActive   Boolean  @default(true)
  assignedAt DateTime @default(now())

  // العلاقات
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade) 
  staff   User  @relation("StaffAssignments", fields: [staffId], references: [id])

  @@unique([eventId, staffId]) // يمنع إضافة نفس الموظف لنفس الفعالية مرتين
}

// تسجيلات الحضور (الزوار)
model Registration {
  id           String   @id @default(uuid())
  eventId      String
  fullName     String
  email        String
  phone        String?
  organization String?
  jobTitle     String?
  status       RegistrationStatus @default(PENDING)
  registeredAt DateTime           @default(now())
  approvedAt   DateTime?
  rejectedAt   DateTime?

  // العلاقات
   event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  checkInToken CheckInToken? // واحد لواحد
  checkIn      CheckIn?      // واحد لواحد
   ticketTypeId String?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@index([ticketTypeId])

  // منع تكرار البريد الإلكتروني لنفس الفعالية
  @@unique([eventId, email])
}

// رمز QR المميز (ينشأ عند الموافقة على التسجيل)
model CheckInToken {
  id             String   @id @default(uuid())
  registrationId String   @unique
  token          String   @unique // UUID v4 عشوائي
  createdAt      DateTime @default(now())

  // العلاقة العكسية
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

// سجلات الدخول (Check-in)
model CheckIn {
  id               String         @id @default(uuid())
  registrationId   String         @unique
  checkedInAt      DateTime       @default(now())
  method           CheckInMethod
  checkedByUserId  String
  gateId           String? 

  // العلاقات
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  checkedBy     User         @relation("CheckInByUser", fields: [checkedByUserId], references: [id])
  gate          Gate?        @relation(fields: [gateId], references: [id])

  @@index([gateId])
}

// الإشعارات داخل التطبيق
model Notification {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String   @default("system")   // ✅ قيمة افتراضية للصفوف القديمة
  title             String
  message           String   @db.Text
  isRead            Boolean  @default(false)
  priority          String   @default("medium")   // ✅ قيمة افتراضية للصفوف القديمة
  metadata          Json?                         // ✅ اختياري (nullable)
  relatedEntityType String?
  relatedEntityId   String?
  createdAt         DateTime @default(now())
}

// سجل التدقيق (Audit Log) اختياري لكن مفيد
model AuditLog {
   id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?
}

model Waitlist {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email      String   // بريد الحضور (نفس البريد المستخدم في التسجيل)
  fullName   String
  phone      String?
  organization String?
  jobTitle   String?
  registeredAt DateTime @default(now())
  promotedAt DateTime?  // عندما يتم ترقيتها إلى تسجيل مقبول
  status     WaitlistStatus @default(WAITING)
  
  // لمنع ازدواجية البريد لنفس الفعالية في قائمة الانتظار
  @@unique([eventId, email])
}

enum WaitlistStatus {
  WAITING
  PROMOTED
  EXPIRED
  CANCELLED
}
// المتحدثون
model Speaker {
  id        String   @id @default(uuid())
  eventId   String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  title     String?  // المسمى الوظيفي
  bio       String?  // السيرة الذاتية
  imageUrl  String?  // رابط الصورة
  order     Int      @default(0) // ترتيب العرض
  createdAt DateTime @default(now())
  agendaItems AgendaItem[]

}

// فقرات الأجندة
model AgendaItem {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  time       String   // "09:00 - 10:00"
  title      String
  description String?
  speakerId  String?  // ربط بمتحدث (اختياري)
  speaker    Speaker? @relation(fields: [speakerId], references: [id])
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}
model Faq {
  id        String   @id @default(uuid())
  eventId   String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  question  String
  answer    String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// الشركاء
model Sponsor {
  id        String   @id @default(uuid())
  eventId   String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  logoUrl   String?
  websiteUrl String?
  tier      String?  // platinum, gold, silver, bronze
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
}

// معرض الصور
model GalleryImage {
  id        String   @id @default(uuid())
  eventId   String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  imageUrl  String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId])
}
model Gate {
  id        String   @id @default(uuid())
  eventId   String
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String   // "البوابة الرئيسية", "بوابة VIP"
  location  String?  // وصف الموقع
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // العلاقات
  checkIns    CheckIn[]
  staffGates  EventStaffGate[]
  allowedTicketTypes TicketType[]  // علاقة many-to-many


  @@index([eventId])
}

// علاقة many-to-many بين الموظفين والبوابات
model EventStaffGate {
  id        String   @id @default(uuid())
  staffId   String
  gateId    String
  staff     User     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  gate      Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([staffId, gateId])
  @@index([staffId])
  @@index([gateId])
}
model TicketType {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String   // "Standard", "VIP", "Student", "Speaker", ...
  description String?
  color       String?  // لون للتمييز (hex)
  capacity    Int?     // سعة اختيارية لهذا النوع (null = لا حد)
  price       Float?   // اختياري (للمستقبل)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // العلاقات
  registrations Registration[]
  gates         Gate[]         // البوابات التي تقبل هذا النوع

  @@index([eventId])
}
